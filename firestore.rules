rules_version = '2';

// §8 - a user can read and write only under their own users/{uid}. animeCache
// is world-readable but only Cloud Functions (which bypass rules via the Admin
// SDK) may write it, so no client can poison the shared metadata cache.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /entries/{anilistId} {
        allow read: if isOwner(uid);
        // The document id must be the AniList id (§8) - this is what makes
        // writes idempotent and re-imports duplicate-free.
        allow create, update: if isOwner(uid)
          && request.resource.data.anilistId is int
          && string(request.resource.data.anilistId) == anilistId
          && request.resource.data.progress is int
          && request.resource.data.progress >= 0
          && request.resource.data.status in
             ['WATCHING', 'PLANNING', 'COMPLETED', 'ON_HOLD', 'DROPPED', 'REWATCHING']
          && (request.resource.data.score == null
              || (request.resource.data.score is number
                  && request.resource.data.score >= 0
                  && request.resource.data.score <= 100));
        allow delete: if isOwner(uid);
      }

      match /customLists/{listId} {
        allow read, write: if isOwner(uid);
      }

      // Push tokens are managed only by the authenticated callable function;
      // clients must never read or forge device registrations directly.
      match /devices/{deviceId} {
        allow read, write: if false;
      }
    }

    // Shared metadata cache - one fetch serves every user (§8 rules).
    match /animeCache/{anilistId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Notification queue is entirely server-side.
    match /notificationQueue/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
