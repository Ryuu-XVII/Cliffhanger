# Copy to .env and fill in. The Supabase publishable key is safe for the client;
# protect all privileged keys and database service-role keys on the server.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OAuth web client id from Google Cloud console (no secret in the client).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# AniList app client id from https://anilist.co/settings/developer
EXPO_PUBLIC_ANILIST_CLIENT_ID=
