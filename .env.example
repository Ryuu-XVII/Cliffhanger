# Copy to .env and fill in. The Supabase publishable key is safe for the client;
# protect all privileged keys and database service-role keys on the server.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OAuth web client id from Google Cloud console (no secret in the client).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# AniList app client id from https://anilist.co/settings/developer
EXPO_PUBLIC_ANILIST_CLIENT_ID=
