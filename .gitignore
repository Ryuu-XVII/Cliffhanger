# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
supabase/.temp/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
firebase-debug.log
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase Android config. Required for FCM push registration, but it carries a
# project API key, so it stays out of a public repo. Restore it with:
#   npm run fetch:google-services
google-services.json

# FCM V1 service account key. A real private key - upload it to EAS, never commit it.
fcm-service-account.json

# Play Store upload keystore and its passwords. Losing these means you can never
# ship an update under the same listing - back them up outside this repo.
credentials/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.env
.env.local

# Build artifacts. A 123MB APK was committed once and is still in history -
# reclaiming that space needs a history rewrite (git filter-repo / BFG), which
# rewrites already-pushed commits, so it is a deliberate call, not a cleanup.
releases/
